# SMTP Configuration for Email Sending
# Configure these variables to enable the contact form email functionality

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
# For Gmail: Use your email and an "App Password" (not your regular password)
# See: https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Example with Gmail App Password
# SMTP_USER=manishraina2009@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Other SMTP Providers:
# Outlook/Office365:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false

# SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key

# AWS SES:
# SMTP_HOST=email-smtp.region.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
